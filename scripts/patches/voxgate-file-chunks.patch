diff --git a/internal/server/minute_batch_test.go b/internal/server/minute_batch_test.go
new file mode 100644
index 0000000..9cbb705
--- /dev/null
+++ b/internal/server/minute_batch_test.go
@@ -0,0 +1,60 @@
+package server
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/WEIFENG2333/voxgate/internal/asr"
+)
+
+func TestMinuteBatchUsesConfiguredChunksBelowThirtySeconds(t *testing.T) {
+	wsURL, closeWS := mockASRServer(t, "完整片段。")
+	defer closeWS()
+	creds := filepath.Join(t.TempDir(), "creds.json")
+	if err := asr.SaveCredentials(creds, asr.Credentials{
+		DeviceID: "1", Token: "t", TokenUpdatedAtMS: time.Now().UnixMilli(),
+	}); err != nil {
+		t.Fatal(err)
+	}
+	// Exercise the configured threshold as well as stitching across sessions.
+	wav := minimalWAV()[:44]
+	wav = append(wav, make([]byte, 16000*2*5/2)...)
+	binary.LittleEndian.PutUint32(wav[4:8], uint32(len(wav)-8))
+	binary.LittleEndian.PutUint32(wav[40:44], uint32(len(wav)-44))
+	srv := New(Config{CredentialPath: creds, WebSocketURL: wsURL,
+		ChunkDuration: time.Second, RequestTimeout: 10 * time.Second})
+	for _, stream := range []bool{false, true} {
+		fields := []field{}
+		if stream {
+			fields = append(fields, field{"stream", "true"})
+		}
+		body, contentType := multipartBody(t, "minute-batch.wav", wav, fields...)
+		request := httptest.NewRequest(http.MethodPost, "/v1/audio/transcriptions", body)
+		request.Header.Set("Content-Type", contentType)
+		response := httptest.NewRecorder()
+		srv.Handler().ServeHTTP(response, request)
+		if response.Code != http.StatusOK {
+			t.Fatalf("stream=%v: HTTP %d: %s", stream, response.Code, response.Body.String())
+		}
+		want := strings.Repeat("完整片段。", 3)
+		if stream {
+			if !strings.Contains(response.Body.String(), `"text":"`+want+`"`) {
+				t.Fatalf("stream lost chunk text: %s", response.Body.String())
+			}
+		} else {
+			var result map[string]string
+			if err := json.Unmarshal(response.Body.Bytes(), &result); err != nil {
+				t.Fatal(err)
+			}
+			if result["text"] != want {
+				t.Fatalf("text=%q, want %q", result["text"], want)
+			}
+		}
+	}
+}
